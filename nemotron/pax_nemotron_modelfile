# PAX-Coder Nemotron deployment
# Ahmad Ali Parr · Bel Esprit D'Accord Irrevocable Trust
# Sovereign runtime — not Ollama default

FROM Snapkitty/snapkitty-nemotron:70b-sovereign

COPY pax-coder-snapkitty-nemotron-lora /opt/pax-lora

# Deterministic runtime
ENV PAX_DETERMINISTIC=1
ENV PAX_ENTROPY=0.0
ENV PAX_SEED=0xDEADBEEF

# PAX Architecture enforcement
ENV PAX_AXIOM_1=index_space_primacy
ENV PAX_AXIOM_2=permission_necessity
ENV PAX_AXIOM_3=sync_state_transition
ENV PAX_AXIOM_4=warp_distinctness
ENV PAX_AXIOM_5=verification_non_negotiable

# All 8 proof obligations required
ENV PAX_PO_REQUIRED="PO1,PO2,PO3,PO4,PO5,PO6,PO7,PO8"

COPY ptxas-sovereign /opt/ptxas-sovereign
ENV PATH="/opt/ptxas-sovereign:${PATH}"

COPY bifrost-client /opt/bifrost-client
ENV BIFROST_ENDPOINT="your-bifrost-endpoint"

ENTRYPOINT ["pax-coder-nemotron"]
CMD ["--verify-all", "--audit-chain"]
